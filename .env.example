VITE_API_ID=00000000 # put your API id here
VITE_API_HASH='XXXXXXXXXXXXXXXXXXXXXXX' # put your API hash here
# Security fixes default ON. Set only the affected flag to 0 for rollback.
VITE_SECURITY_STREAM_GUARD=1
VITE_SECURITY_UPLOAD_OWNER=1
VITE_SECURITY_LOG_OWNER=1
# Feature flags default ON. Set to 0 and rebuild to switch the feature off.
# SPLIT_LARGE: files over Telegram's limit are stopped before upload, with
# the command to cut them (utils/splitPlan.js).
VITE_FEATURE_SPLIT_LARGE=1
# LOCAL_HELPER: the dialog offers to cut a big video with the ffmpeg on this
# computer through public/helper/cloudgram-helper.mjs. Needs the loopback
# origin in connect-src (docs/csp.md). It also plays the parts of one cut video
# ("name.part001.mp4"...) as one video. 0 = only the command is shown, parts
# play one by one.
VITE_FEATURE_LOCAL_HELPER=1
# EXTERNAL_PLAYER: a video gets "Mở bằng PotPlayer, VLC..." (menu, preview).
# The same helper serves the video to the player on 127.0.0.1, the tab
# supplies the bytes. Same connect-src as LOCAL_HELPER. 0 = the buttons go away.
VITE_FEATURE_EXTERNAL_PLAYER=1
# PLAY_DIRECT_URL: where the tab puts the video chunks for an outside player,
# bypassing Cloudflare (slow to upload to the VPS from some networks). Set up
# by deploy/vps-direct-upload.sh; empty = through the page's own address.
# VITE_PLAY_DIRECT_URL=https://up.datvan.com:8444
# SPLIT_RAW: a file over Telegram's limit is sent as several raw slices (one
# message each) that the drive keeps as one file: no helper, no ffmpeg, any
# file type (utils/splitPlan.js). Needs SPLIT_LARGE. 0 = such files are stopped
# before upload again; ones already sent still download and play.
VITE_FEATURE_SPLIT_RAW=1
