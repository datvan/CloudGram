# Copy to server/.env.dev for `npm run dev:api`. Local only.
CLOUDGRAM_PEPPER=dev-pepper-dev-pepper-dev-pepper-dev
CLOUDGRAM_DATA=./server/.data
CLOUDGRAM_ORIGIN=http://localhost:5173
CLOUDGRAM_INSECURE_COOKIES=1
# Security fixes default ON; only literal 0 disables a fix.
CLOUDGRAM_SECURITY_CREDENTIAL_GUARD=1
CLOUDGRAM_SECURITY_SHARE_QUOTA=1
